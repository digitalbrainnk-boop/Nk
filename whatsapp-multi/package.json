{
  "name": "whatsapp-multi",
  "version": "1.0.0",
  "private": true,
  "description": "Supervision de plusieurs comptes WhatsApp Business, chacun dans une session isolée (backend Node.js + PWA)",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "postinstall": "node scripts/copy-vendor.js",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=20.12"
  },
  "license": "ISC",
  "dependencies": {
    "baileys": "^7.0.0-rc14",
    "express": "^5.3.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.4"
  }
}
