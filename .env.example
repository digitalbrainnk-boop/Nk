# Copie ce fichier en ".env" et remplis au moins ANTHROPIC_API_KEY.
ANTHROPIC_API_KEY=
# Mot de passe du tableau de bord (sinon un mot de passe est généré et affiché au démarrage)
ADMIN_PASSWORD=
PORT=3000

# Optionnel : tout peut aussi se régler dans le tableau de bord.
TRANSCRIPTION_API_KEY=
TELEGRAM_BOT_TOKEN=
FACEBOOK_PAGE_TOKEN=
FACEBOOK_APP_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_VERIFY_TOKEN=
WA_CLOUD_TOKEN=
WA_CLOUD_PHONE_NUMBER_ID=
