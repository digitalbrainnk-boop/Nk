# Copie ce fichier en « .env » pour changer un réglage (facultatif).

# Port de l'application (3100 par défaut : l'agent IA du dépôt utilise déjà 3000)
PORT=3100

# Adresse d'écoute : 0.0.0.0 = accessible depuis le Wi-Fi ; 127.0.0.1 = seulement
# depuis cette machine (ex. derrière Caddy/Nginx sur un serveur).
# HOST=0.0.0.0

# Jeton d'accès de l'application. Laisse vide : il est généré au premier
# démarrage et enregistré dans data/api-token.txt.
API_TOKEN=

# Dossier des données (un sous-dossier par ligne : clés WhatsApp + historique)
# DATA_DIR=./data

# Origines autorisées à appeler l'API depuis un autre domaine (séparées par des virgules).
# Par défaut : celles de l'application Capacitor (Android/iOS).
# CORS_ORIGINS=capacitor://localhost,http://localhost,https://localhost

# Derrière un reverse proxy HTTPS (Nginx, Caddy…) : 1
# TRUST_PROXY=1

# Ouvrir le navigateur au démarrage (les scripts DEMARRER et « lignes » le font déjà)
# OPEN_BROWSER=1

# Limites
# MAX_SESSIONS=10
# MAX_MESSAGES_PER_CHAT=200
# MAX_CHATS_PER_SESSION=500

# Fichiers : téléchargés tout de suite jusqu'à cette taille (Mo), sinon à l'ouverture
# MEDIA_AUTO_DOWNLOAD_MB=16
# Taille maximale d'un fichier envoyé depuis l'app (Mo)
# MAX_UPLOAD_MB=64

# Récupérer les conversations récentes au moment de l'appairage (1 = oui)
# HISTORY_SYNC=1

# Reconnexion automatique (délai exponentiel plafonné ; 0 tentative max = illimité)
# RECONNECT_BASE_DELAY_MS=2000
# RECONNECT_MAX_DELAY_MS=120000
# RECONNECT_MAX_ATTEMPTS=0

# Journaux : trace | debug | info | warn | error ; LOG_FORMAT=json pour du JSON brut
LOG_LEVEL=info
# Journaux internes de Baileys (très bavards) : silent | warn | debug
BAILEYS_LOG_LEVEL=silent
