# =============================================================================
# Winner Pronostic — variables d'environnement
# Copiez ce fichier en « .env.local » (développement) puis remplissez-le.
# En production, saisissez les mêmes variables dans Vercel :
#   Project → Settings → Environment Variables
# NE JAMAIS committer de vraies clés.
# =============================================================================

# --- Phase 1 : Supabase (Project Settings → API Keys) ------------------------
# URL du projet, ex. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Clé publique « publishable » (sb_publishable_…) ou ancienne « anon key ».
# Publique par nature : la sécurité repose sur la Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clé SECRÈTE (sb_secret_…) ou ancienne « service_role ». Serveur uniquement !
SUPABASE_SECRET_KEY=

# Adresse publique du site (liens des e-mails de confirmation)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sel pour anonymiser les compteurs anti-abus (16 caractères aléatoires minimum)
# Générer : openssl rand -hex 24
RATE_LIMIT_SALT=

# --- Phase 2 : API-Sports (https://dashboard.api-football.com) --------------
# Une seule clé pour football, basketball, hockey, handball, volley, rugby…
# (chaque sport a son propre quota : vérifiez votre offre dans le tableau de bord)
# API_SPORTS_KEY=
# Secret partagé avec les tâches planifiées (Vercel Cron) : openssl rand -hex 32
# CRON_SECRET=

# --- Phase 6 : paiements Mobile Money (CinetPay ou FedaPay) ------------------
# CINETPAY_API_KEY=
# CINETPAY_SITE_ID=
# CINETPAY_SECRET_KEY=
# FEDAPAY_SECRET_KEY=
# FEDAPAY_WEBHOOK_SECRET=

# --- Phase 7 : notifications push (npx web-push generate-vapid-keys) ---------
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:contact@exemple.com

# --- Facultatif : page /apercu (composants avec données fictives) en production
# NEXT_PUBLIC_DESIGN_PREVIEW=1

# --- Tests de la base (facultatif) : PostgreSQL local --------------------------
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
