{
  "name": "maquis-pro-manager",
  "version": "1.0.0",
  "description": "MAQUIS PRO MANAGER : gestion complète d'un maquis (stocks, ventes, caisse, reçus, bilans automatiques à 03 h 00)",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --watch src/server.js",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 test/",
    "rapports": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/rapports.js",
    "sauvegarde": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/sauvegarde.js",
    "restaurer": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/restaurer.js"
  },
  "engines": {
    "node": ">=22.16"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "express": "^5.3.0",
    "fflate": "^0.8.3",
    "pdfkit": "^0.20.2",
    "web-push": "^3.6.7"
  }
}
