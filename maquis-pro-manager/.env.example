# Copiez ce fichier en « .env » à côté de l'application.
# Dossier des données (base, reçus, sauvegardes) : HORS du dossier public du site.
DATA_DIR=/home/utilisateur/maquis-donnees
PORT=3000
# Code utilisé une seule fois pour créer le compte du propriétaire (sinon un code est généré
# et écrit dans DATA_DIR/CODE-INSTALLATION.txt).
SETUP_CODE=
# Adresse de contact pour les notifications push (exigée par les services de notification).
VAPID_SUBJECT=mailto:votre-adresse@exemple.com
# Nombre de sauvegardes quotidiennes conservées.
BACKUP_KEEP=30
# Fuseau horaire du maquis (Burkina Faso par défaut).
MAQUIS_TZ=Africa/Ouagadougou
