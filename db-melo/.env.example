# ─── DB.Mélo : copie ce fichier en ".env.local" et remplis ce dont tu as besoin ───
# Sans aucune clé, l'application tourne en MODE DÉMO (musique de démonstration, paiement simulé).

# Adresse publique du site (webhooks Kie / CinetPay / Stripe, liens cadeau, QR codes)
PUBLIC_BASE_URL=https://dbmelo.example.com

# ── Moteur musical : Suno via Kie.ai (https://kie.ai → API Keys)
KIE_API_KEY=
# Modèle Suno : V5 (éprouvé), ou V6 / V6_MINI / V6_WILD (plus récents : à écouter avant d'adopter)
KIE_SUNO_MODEL=V5
# takes (par défaut) : 1 composition Suno par chanson, ses 2 prises font les 2 versions (≈ 12 crédits)
# styles : 2 compositions, une rythmée et une acoustique (≈ 24 crédits, deux fois plus cher)
VERSIONS_MODE=takes
# Secret qui signe l'adresse de rappel Kie (sinon dérivé de KIE_API_KEY)
KIE_CALLBACK_SECRET=
# Pochettes IA (offre Prestige)
KIE_IMAGE_MODEL=google/nano-banana
KIE_IMAGE_EDIT_MODEL=google/nano-banana-edit

# ── Parolier IA : Claude (prioritaire) ou DeepSeek via Kie.ai, sinon modèles intégrés
ANTHROPIC_API_KEY=
LYRICS_MODEL=claude-opus-5-5
KIE_CHAT_MODEL=deepseek-v4-1-flash

# ── Parcours : pay_first (défaut : paroles validées → paiement → composition)
#    ou preview_first (pré-écoute avant paiement : déconseillé, l'extrait peut être enregistré)
FLOW_MODE=pay_first
PREVIEW_SECONDS=45
# Compositions Suno autorisées par chanson (relances après un échec comprises)
MAX_GENERATION_ATTEMPTS=3
# En preview_first : créations autorisées par adresse IP et par heure (protège ton crédit Kie)
GENERATIONS_PER_HOUR=4

# Prix : 1 000 FCFA la chanson (équivalents des autres monnaies dans src/lib/constants.ts → SONG_PRICES)

# ── Mobile Money Afrique de l'Ouest et centrale : CinetPay (Orange Money, Wave, MTN, Moov, Airtel, M-Pesa RDC…)
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=

# ── Flutterwave : Mobile Money Ghana, Kenya (M-Pesa), Ouganda, Rwanda, Zambie, Tanzanie + cartes partout en Afrique
FLUTTERWAVE_SECRET_KEY=
# « Secret hash » choisi dans le tableau de bord Flutterwave (Webhooks)
FLUTTERWAVE_WEBHOOK_HASH=

# ── Paystack (cartes + Mobile Money Ghana / Kenya / Côte d'Ivoire) — optionnel
PAYSTACK_SECRET_KEY=

# E-mail du marchand : utilisé pour le reçu quand une passerelle exige un e-mail et que le client n'en donne pas
MERCHANT_EMAIL=

# ── Stripe (Visa, Mastercard, Apple Pay, Google Pay — EUR / USD / XOF / XAF)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Paiement simulé : uniquement pour tester (ne jamais activer en production)
ALLOW_DEMO_PAYMENTS=false

# Avancé : adresses de l'API Kie (proxy, tests)
# KIE_API_BASE=https://api.kie.ai/api/v1
# KIE_UPLOAD_BASE=https://kieai.redpandaai.co

# ── Stockage : dossier local persistant (VPS, Render + disque)…
DATA_DIR=.data
# …ou Upstash Redis (Vercel / serverless)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
