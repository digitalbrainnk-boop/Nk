<?xml version="1.0" encoding="utf-8"?>
<!-- Android 10 et plus : thème jour/nuit, pour que la page suive le mode sombre du téléphone (prefers-color-scheme). -->
<resources>
    <style name="Theme.App" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:colorPrimary">@color/cuivre</item>
        <item name="android:colorPrimaryDark">@color/cuivre_fonce</item>
        <item name="android:colorAccent">@color/cuivre</item>
        <item name="android:statusBarColor">@color/cuivre_fonce</item>
        <item name="android:windowBackground">@color/fond</item>
    </style>
</resources>
