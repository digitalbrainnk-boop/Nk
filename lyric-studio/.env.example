# Copie ce fichier en « .env » (tout est facultatif, les clés se règlent aussi dans le studio).
PORT=3500
# HOST=0.0.0.0 pour ouvrir le studio au réseau : un mot de passe est alors exigé.
HOST=
STUDIO_PASSWORD=

# Transcription mot par mot (paroles absentes ou synchro automatique) :
# Groq (gratuit) : https://console.groq.com/keys  — ou OpenAI : TRANSCRIPTION_URL=https://api.openai.com/v1/audio/transcriptions et TRANSCRIPTION_MODEL=whisper-1
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_URL=
TRANSCRIPTION_MODEL=
# ou ElevenLabs Scribe (très précis sur le chant)
ELEVENLABS_API_KEY=
# Chansons Suno (Kie.ai) : import avec paroles horodatées et séparation de la voix
KIE_API_KEY=

# Séparation de la voix sur l'ordinateur (pip install demucs)
DEMUCS_CMD=
DEMUCS_MODEL=
# Taille maximale d'un fichier envoyé (Mo)
MAX_UPLOAD_MB=
