# Copie ce fichier en « .env ». Tout est facultatif sauf DOMAIN sur un serveur avec docker compose.
PORT=3500

# Ton nom de domaine (serveur avec docker compose + HTTPS automatique)
DOMAIN=

# Cette adresse e-mail devient administrateur à l'inscription (sinon : le premier compte créé).
ADMIN_EMAIL=

# Valeurs de départ (modifiables ensuite dans Administration → Site et IA)
APP_NAME=
SUPPORT_WHATSAPP=
SUPPORT_EMAIL=

# Synchronisation par IA (une clé suffit, modifiable aussi dans l'administration)
# Groq (gratuit) : https://console.groq.com/keys — ou OpenAI : TRANSCRIPTION_URL=https://api.openai.com/v1/audio/transcriptions et TRANSCRIPTION_MODEL=whisper-1
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_URL=
TRANSCRIPTION_MODEL=
# ElevenLabs Scribe (très précis sur le chant)
ELEVENLABS_API_KEY=
# Chansons Suno (Kie.ai)
KIE_API_KEY=

# Application Android du Play Store (valeurs données par PWABuilder / Bubblewrap)
ANDROID_PACKAGE=
ANDROID_SHA256=
ANDROID_APP_URL=

# Séparation de la voix sur le serveur (Demucs installé) : commande, modèle, nombre en parallèle
DEMUCS_CMD=
DEMUCS_MODEL=
DEMUCS_CONCURRENCY=1
# Taille maximale d'un fichier envoyé (Mo)
MAX_UPLOAD_MB=
