{
  "name": "lyric-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Lyric Studio : vidéos lyriques et karaoké synchronisées mot par mot, export MP4 720p / 1080p / 4K",
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --watch src/server.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js"
  },
  "dependencies": {
    "express": "^5.2.1",
    "mp4-muxer": "^5.2.2",
    "multer": "^2.4.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
