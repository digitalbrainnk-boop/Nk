# Configuration de Lyric Studio chez o2switch (ce fichier n'est jamais écrasé par les mises à jour).
# Seule cette adresse e-mail devient administrateur quand elle s'inscrit :
ADMIN_EMAIL=
# Dossier des données (comptes, projets, vidéos) :
DATA_DIR=
# ffmpeg (installé automatiquement si possible) :
FFMPEG_PATH=
FFPROBE_PATH=
# Taille maximale d'un fichier envoyé (Mo) :
MAX_UPLOAD_MB=1024
# Le reste (nom du site, WhatsApp, clés d'IA, formules et prix) se règle dans Administration.
